# Stages replaced with mock data from contracts/samples/: all | empty | list (extract,events,audit,render,report)
CP_STUBS=all
# piper (default offline) | edge-tts (optional high-fidelity online Romanian) | espeak | say
TTS_ENGINE=piper
# Optional voice override when TTS_ENGINE=edge-tts (defaults to ro-RO-EmilNeural)
# EDGE_TTS_VOICE=ro-RO-EmilNeural
MAX_EVENTS=40
# Video sync correction in seconds (see doc/2-tracks/m3-media.md)
VIDEO_OFFSET=0.0
# Allowed hosts even if local/private
ALLOWED_HOSTS=localhost,127.0.0.1
KEEP_TMP=0
TEST_URL=http://localhost:8080/bad-checkout.html
