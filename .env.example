# Stages replaced with mock data from contracts/samples/: all | empty | list (extract,events,audit,render,report)
CP_STUBS=all
# piper (default) | espeak (requires espeak-ng installed) | say (macOS only, Ioana voice)
TTS_ENGINE=piper
MAX_EVENTS=40
# Video sync correction in seconds (see doc/2-tracks/m3-media.md)
VIDEO_OFFSET=0.0
# Allowed hosts even if local/private
ALLOWED_HOSTS=localhost,127.0.0.1
KEEP_TMP=0
TEST_URL=http://localhost:8080/bad-checkout.html
